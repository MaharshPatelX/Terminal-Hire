/* TUI-Hire application layout and chrome */

TerminalHireApp {
    background: $background;
    color: $foreground;
}

/* Workspace chrome (non-welcome screens) */
#top-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: $background;
    color: $text-muted;
    padding: 0 1;
}

#status-strip {
    dock: top;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#footer-hints {
    dock: bottom;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#footer-hints .key {
    color: $primary;
    text-style: bold;
}

/* ---- Welcome workspace ---- */

WelcomeScreen {
    layout: vertical;
    background: $background;
}

#welcome-topbar {
    dock: top;
    width: 100%;
    height: 1;
    padding: 0 2;
    color: $text-muted;
    background: $background;
}

#workspace-name {
    width: auto;
    height: 1;
}

#workspace-runtime {
    dock: right;
    width: auto;
    height: 1;
    text-align: right;
}

#welcome-main {
    width: 100%;
    height: 1fr;
    align: center top;
    padding: 2 3 0 3;
}

#welcome-card {
    width: 112;
    max-width: 94%;
    height: 20;
    border: round #30363d;
    background: #0f141b;
}

#identity-pane {
    width: 34;
    height: 100%;
    padding: 2 3;
    background: #111820;
    border-right: solid #30363d;
}

#brand-glyph {
    width: 100%;
    height: 3;
    content-align: left middle;
    color: #63e6be;
    text-style: bold;
}

#brand-name {
    width: 100%;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#brand-kicker,
.eyebrow,
.section-label {
    width: 100%;
    height: 1;
    color: #63e6be;
    text-style: bold;
}

#brand-kicker {
    margin-bottom: 2;
}

#brand-copy {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-bottom: 2;
}

#brand-policy {
    width: 100%;
    height: auto;
    color: $text-muted;
}

#workspace-pane {
    width: 1fr;
    height: 100%;
    padding: 2 3;
}

#workspace-title {
    width: 100%;
    height: 1;
    color: $foreground;
    text-style: bold;
}

#workspace-subtitle {
    width: 100%;
    height: 1;
    color: $text-muted;
    margin-bottom: 2;
}

#workspace-grid {
    width: 100%;
    height: 1fr;
}

#launchpad {
    width: 1fr;
    height: 100%;
    padding-right: 3;
}

#readiness {
    width: 29;
    height: 100%;
    padding-left: 2;
    border-left: solid #30363d;
}

.section-label {
    color: $text-muted;
    margin-bottom: 1;
}

#menu {
    width: 100%;
    height: auto;
}

.menu-row {
    width: 100%;
    height: 1;
    color: $foreground;
}

.menu-row:hover,
.menu-row.-selected {
    background: #1b2631;
}

.menu-label {
    width: 1fr;
    height: 1;
}

.menu-key {
    width: 3;
    height: 1;
    text-align: right;
    color: $text-muted;
}

.ready-row {
    width: 100%;
    height: 1;
    color: $foreground;
    margin-bottom: 1;
}

#composer-shell {
    dock: bottom;
    width: 100%;
    height: 7;
    padding: 0 3 1 3;
    background: $background;
}

#composer-tip {
    width: 100%;
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

#welcome-prompt {
    width: 100%;
    height: 3;
    border: round #484f58;
    background: #0f141b;
    padding: 0 1;
}

#welcome-prompt:focus {
    border: round #63e6be;
}

#composer-meta {
    width: 100%;
    height: 1;
}

#composer-keys {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

#composer-status {
    width: auto;
    height: 1;
    text-align: right;
}

WelcomeScreen.-compact #identity-pane {
    display: none;
}

WelcomeScreen.-compact #readiness,
WelcomeScreen.-compact #workspace-runtime,
WelcomeScreen.-compact #composer-status {
    display: none;
}

WelcomeScreen.-compact #welcome-card {
    width: 96%;
}

WelcomeScreen.-short #welcome-main {
    padding-top: 1;
}

WelcomeScreen.-short #welcome-card {
    height: 15;
}

WelcomeScreen.-short #workspace-pane {
    padding: 1 2;
}

WelcomeScreen.-short #workspace-subtitle,
WelcomeScreen.-short #brand-policy {
    display: none;
}

WelcomeScreen.-short #brand-kicker,
WelcomeScreen.-short #brand-copy {
    margin-bottom: 0;
}

/* ---- Shared screen chrome ---- */

.screen-title {
    width: 100%;
    height: 1;
    color: $foreground;
    text-style: bold;
    padding: 0 1;
}

.screen-subtitle {
    width: 100%;
    height: 1;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
}

.panel {
    background: $surface;
    border: round #484f58;
    padding: 1 2;
    margin: 0 1 1 1;
    height: auto;
}

.panel-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.muted {
    color: $text-muted;
}

.ok {
    color: $success;
}

.warn {
    color: $warning;
}

.err {
    color: $error;
}

.chat-log {
    height: 1fr;
    border: round #484f58;
    background: $panel;
    padding: 1;
    margin: 0 1;
    overflow-y: auto;
}

#chat-input-row {
    height: auto;
    dock: bottom;
    padding: 1;
}

#chat-input {
    width: 1fr;
    border: round #484f58;
    background: $panel;
    padding: 0 1;
}

#chat-input:focus {
    border: round $primary;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

Input,
TextArea {
    background: $panel;
    border: round #484f58;
    color: $foreground;
}

Input:focus,
TextArea:focus {
    border: round $primary;
}

Button {
    margin-right: 1;
}

DataTable {
    height: 1fr;
    background: $surface;
}

ListView {
    background: $surface;
    border: round #484f58;
    height: 1fr;
}

#profile-layout,
#apps-layout {
    width: 100%;
    height: 1fr;
}

#profile-editor {
    width: 52%;
    height: 100%;
}

#profile-preview {
    width: 1fr;
    height: 100%;
    margin: 0 1 1 0;
}

#apps-list-panel {
    width: 52%;
    height: 100%;
}

#application-review {
    width: 1fr;
    height: 100%;
    margin: 0 1 1 0;
    padding: 1;
    border: round #484f58;
    background: $panel;
}
