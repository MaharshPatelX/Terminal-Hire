/* Grok Build–inspired dark TUI theme for Job Applyer */

$background: #0d1117;
$surface: #161b22;
$panel: #1c2128;
$boost: #21262d;

$primary: #58a6ff;
$secondary: #8b949e;
$accent: #3fb950;
$warning: #d29922;
$error: #f85149;
$success: #3fb950;

$text: #e6edf3;
$text-muted: #8b949e;
$text-disabled: #484f58;

$foreground: $text;

JobApplyerApp {
    background: $background;
    color: $text;
}

Screen {
    background: $background;
}

/* Top bar — repo-style location + version (Grok welcome top_bar) */
#top-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: $background;
    color: $text-muted;
    padding: 0 1;
}

#top-bar .brand {
    color: $text;
    text-style: bold;
}

#top-bar .sep {
    color: $text-disabled;
}

#top-bar .meta {
    color: $text-muted;
}

/* Status strip under nav */
#status-strip {
    dock: top;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#status-strip .ok {
    color: $success;
}

#status-strip .warn {
    color: $warning;
}

#status-strip .off {
    color: $text-disabled;
}

#status-strip .key {
    color: $primary;
}

/* Bottom hint bar */
#footer-hints {
    dock: bottom;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#footer-hints .key {
    color: $primary;
    text-style: bold;
}

/* Main content */
#main {
    width: 100%;
    height: 1fr;
}

/* ---- Welcome / Home (Grok-style: logo → menu → prompt) ---- */

WelcomeScreen {
    align: center middle;
}

#welcome-wrap {
    width: 64;
    max-width: 100%;
    height: auto;
    padding: 1 2;
}

#logo {
    width: 100%;
    height: auto;
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

#logo .shine {
    color: $text;
}

#tagline {
    width: 100%;
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

#menu {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.menu-row {
    width: 100%;
    height: 1;
    padding: 0 1;
}

.menu-row:hover,
.menu-row.-selected {
    background: $boost;
}

.menu-row .label {
    color: $text;
    text-style: bold;
}

.menu-row.-selected .label {
    color: $text;
}

.menu-row .shortcut {
    color: $text-muted;
    dock: right;
}

#welcome-prompt {
    width: 100%;
    margin-top: 1;
    border: tall $boost;
    background: $panel;
    padding: 0 1;
}

#welcome-prompt:focus {
    border: tall $primary;
}

#welcome-hint {
    width: 100%;
    color: $text-disabled;
    text-align: center;
    margin-top: 1;
}

/* ---- Shared screen chrome ---- */

.screen-title {
    width: 100%;
    height: 1;
    color: $text;
    text-style: bold;
    padding: 0 1;
    margin-bottom: 0;
}

.screen-subtitle {
    width: 100%;
    height: 1;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
}

.panel {
    background: $surface;
    border: tall $boost;
    padding: 1 2;
    margin: 0 1 1 1;
    height: auto;
}

.panel-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.muted {
    color: $text-muted;
}

.ok {
    color: $success;
}

.warn {
    color: $warning;
}

.err {
    color: $error;
}

/* Chat-style screens (Onboard / Ask) — scrollback + bottom prompt */
.chat-log {
    height: 1fr;
    border: tall $boost;
    background: $panel;
    padding: 1;
    margin: 0 1;
    overflow-y: auto;
}

.chat-log .role-agent {
    color: $primary;
    text-style: bold;
}

.chat-log .role-user {
    color: $accent;
    text-style: bold;
}

.chat-log .role-system {
    color: $text-muted;
}

#chat-input-row {
    height: auto;
    dock: bottom;
    padding: 1;
}

#chat-input {
    width: 1fr;
    border: tall $boost;
    background: $panel;
    padding: 0 1;
}

#chat-input:focus {
    border: tall $primary;
}

/* Forms */
.form-row {
    height: auto;
    margin-bottom: 1;
}

.form-label {
    color: $text-muted;
    width: 18;
}

Input, TextArea {
    background: $panel;
    border: tall $boost;
    color: $text;
}

Input:focus, TextArea:focus {
    border: tall $primary;
}

Select {
    background: $panel;
    border: tall $boost;
}

Button {
    margin-right: 1;
}

Button.-primary {
    background: $primary;
    color: $background;
    text-style: bold;
}

Button.-success {
    background: $success;
    color: $background;
}

Button.-warning {
    background: $warning;
    color: $background;
}

DataTable {
    height: 1fr;
    background: $surface;
}

ListView {
    background: $surface;
    border: tall $boost;
    height: 1fr;
}

ListItem {
    padding: 0 1;
}

ListItem:hover {
    background: $boost;
}

ListItem.-highlighted {
    background: $boost;
}
