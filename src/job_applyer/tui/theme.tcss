/* TUI-Hire — Grok Build–inspired layout & chrome */

TerminalHireApp {
    background: $background;
    color: $foreground;
}

/* Workspace chrome (non-welcome screens) */
#top-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: $background;
    color: $text-muted;
    padding: 0 1;
}

#status-strip {
    dock: top;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#footer-hints {
    dock: bottom;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#footer-hints .key {
    color: $primary;
    text-style: bold;
}

/* ---- Welcome (Grok hero box) ---- */

WelcomeScreen {
    layout: vertical;
    align: center middle;
    background: $background;
}

#welcome-stack {
    width: 88;
    max-width: 96%;
    height: auto;
    align: center middle;
}

#hero-box {
    width: 100%;
    height: auto;
    border: round #484f58;
    padding: 1 2;
    background: $background;
}

#hero-logo {
    width: 20;
    height: auto;
    color: $text-muted;
    padding: 0 2 0 0;
    text-align: left;
}

#hero-right {
    width: 1fr;
    height: auto;
    padding: 0 1;
}

#hero-title {
    width: 100%;
    height: 1;
    color: $foreground;
    margin-bottom: 1;
}

#hero-blurb {
    width: 100%;
    height: auto;
    color: $text-muted;
    margin-bottom: 1;
}

#menu {
    width: 100%;
    height: auto;
    margin-top: 1;
}

.menu-row {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $foreground;
}

.menu-row:hover,
.menu-row.-selected {
    background: #21262d;
}

#welcome-tip {
    width: 100%;
    height: auto;
    color: $text-muted;
    text-align: center;
    margin-top: 1;
    margin-bottom: 1;
}

#welcome-prompt {
    width: 100%;
    border: round #484f58;
    background: $background;
    padding: 0 1;
    margin-top: 0;
}

#welcome-prompt:focus {
    border: round $primary;
}

#welcome-foot {
    width: 100%;
    height: 1;
    color: $text-muted;
    text-align: right;
    margin-top: 0;
}

/* ---- Shared screen chrome ---- */

.screen-title {
    width: 100%;
    height: 1;
    color: $foreground;
    text-style: bold;
    padding: 0 1;
}

.screen-subtitle {
    width: 100%;
    height: 1;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
}

.panel {
    background: $surface;
    border: round #484f58;
    padding: 1 2;
    margin: 0 1 1 1;
    height: auto;
}

.panel-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.muted {
    color: $text-muted;
}

.ok {
    color: $success;
}

.warn {
    color: $warning;
}

.err {
    color: $error;
}

.chat-log {
    height: 1fr;
    border: round #484f58;
    background: $panel;
    padding: 1;
    margin: 0 1;
    overflow-y: auto;
}

#chat-input-row {
    height: auto;
    dock: bottom;
    padding: 1;
}

#chat-input {
    width: 1fr;
    border: round #484f58;
    background: $panel;
    padding: 0 1;
}

#chat-input:focus {
    border: round $primary;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

Input,
TextArea {
    background: $panel;
    border: round #484f58;
    color: $foreground;
}

Input:focus,
TextArea:focus {
    border: round $primary;
}

Button {
    margin-right: 1;
}

DataTable {
    height: 1fr;
    background: $surface;
}

ListView {
    background: $surface;
    border: round #484f58;
    height: 1fr;
}
