/* Terminal-Hire TUI — layout & chrome (colors come from Theme) */

TerminalHireApp {
    background: $background;
    color: $foreground;
}

/* Top bar — Grok welcome top_bar vibe */
#top-bar {
    dock: top;
    height: 1;
    width: 100%;
    background: $background;
    color: $text-muted;
    padding: 0 1;
}

#status-strip {
    dock: top;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#footer-hints {
    dock: bottom;
    height: 1;
    width: 100%;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#footer-hints .key {
    color: $primary;
    text-style: bold;
}

/* ---- Welcome / Home ---- */

WelcomeScreen {
    layout: vertical;
}

#welcome-wrap {
    width: 90;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    margin: 1 0;
    align-horizontal: center;
}

#logo {
    width: 100%;
    height: auto;
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

#tagline {
    width: 100%;
    color: $text-muted;
    text-align: center;
    margin-bottom: 1;
}

#menu {
    width: 100%;
    height: auto;
    margin-bottom: 1;
}

.menu-row {
    width: 100%;
    height: 1;
    padding: 0 1;
}

.menu-row:hover,
.menu-row.-selected {
    background: $boost;
}

.menu-row .label {
    color: $foreground;
    text-style: bold;
}

.menu-row .shortcut {
    color: $text-muted;
    dock: right;
}

#welcome-prompt {
    width: 100%;
    margin-top: 1;
    border: tall $boost;
    background: $panel;
    padding: 0 1;
}

#welcome-prompt:focus {
    border: tall $primary;
}

#welcome-hint {
    width: 100%;
    color: $text-disabled;
    text-align: center;
    margin-top: 1;
}

/* ---- Shared screen chrome ---- */

.screen-title {
    width: 100%;
    height: 1;
    color: $foreground;
    text-style: bold;
    padding: 0 1;
}

.screen-subtitle {
    width: 100%;
    height: 1;
    color: $text-muted;
    padding: 0 1;
    margin-bottom: 1;
}

.panel {
    background: $surface;
    border: tall $boost;
    padding: 1 2;
    margin: 0 1 1 1;
    height: auto;
}

.panel-title {
    color: $primary;
    text-style: bold;
    margin-bottom: 1;
}

.muted {
    color: $text-muted;
}

.ok {
    color: $success;
}

.warn {
    color: $warning;
}

.err {
    color: $error;
}

.chat-log {
    height: 1fr;
    border: tall $boost;
    background: $panel;
    padding: 1;
    margin: 0 1;
    overflow-y: auto;
}

#chat-input-row {
    height: auto;
    dock: bottom;
    padding: 1;
}

#chat-input {
    width: 1fr;
    border: tall $boost;
    background: $panel;
    padding: 0 1;
}

#chat-input:focus {
    border: tall $primary;
}

.form-row {
    height: auto;
    margin-bottom: 1;
}

Input,
TextArea {
    background: $panel;
    border: tall $boost;
    color: $foreground;
}

Input:focus,
TextArea:focus {
    border: tall $primary;
}

Button {
    margin-right: 1;
}

DataTable {
    height: 1fr;
    background: $surface;
}

ListView {
    background: $surface;
    border: tall $boost;
    height: 1fr;
}
