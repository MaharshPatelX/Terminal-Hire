# Copy to .env for local development only. Never commit .env files.

# --- Safety (supervised submit is opt-in) ---
APPLICATION_DRY_RUN=true
APPLICATION_SUBMISSION_ENABLED=false
APPLICATION_DAILY_LIMIT=5

# --- Local data ---
# Defaults to an OS-local TUI-Hire directory outside the repository/OneDrive.
# DATA_DIR=C:\Users\you\AppData\Local\TUI-Hire
# PROFILE.md is the only source of truth for personal/profile data.
PROFILE_FILENAME=PROFILE.md
DATABASE_FILENAME=terminal_hire.sqlite
ARTIFACT_DIRNAME=artifacts
# Optional override; only sqlite:/// URLs are supported.
# DATABASE_URL=sqlite:///C:/private/path/terminal_hire.sqlite
APP_TIMEZONE=America/Chicago
LOG_LEVEL=info

# Credentials are plaintext in SQLite by explicit product policy.
# Password/OTP values are still excluded from events and screenshots.

# --- Which LLM is active: lmstudio | openrouter | off ---
LLM_PROVIDER=lmstudio

# --- LM Studio (local OpenAI-compatible) ---
LMSTUDIO_ENABLED=true
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_MODEL=replace_with_lm_studio_model_id
LMSTUDIO_EMBEDDING_MODEL=

# --- OpenRouter (cloud OpenAI-compatible) ---
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
OPENROUTER_PROVIDER=venice
OPENROUTER_ALLOW_FALLBACKS=false
OPENROUTER_HTTP_REFERER=https://github.com/MaharshPatelX/Terminal-Hire
OPENROUTER_APP_TITLE=Terminal-Hire
OPENROUTER_TIMEOUT_SECONDS=60
ONBOARDING_AI_ENABLED=true
ONBOARDING_AI_MODEL=deepseek/deepseek-v4-flash
ONBOARDING_AI_MAX_REVIEW_ROUNDS=3

# --- Shared LLM behavior ---
LLM_JSON_PLAN_FALLBACK=true
LLM_TEMPERATURE=0.2
LLM_MAX_TURNS=20

# --- Browser ---
PLAYWRIGHT_HEADLESS=false
BROWSER_MAX_CONCURRENCY=1

# --- OTP (email auto-read is future; keep disabled) ---
EMAIL_OTP_ENABLED=false

# --- Retention defaults (days; review before production) ---
BROWSER_ARTIFACT_RETENTION_DAYS=30
APPLICATION_CONFIRMATION_RETENTION_DAYS=365
LOG_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
